# Clé API Gemini (Google AI Studio).
# ⚠️ Toute variable VITE_* est exposée au navigateur. En production, préférer
#    VITE_GEMINI_PROXY_URL (un petit proxy serveur qui détient la clé).
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-3.6-flash
# Optionnel : si défini, remplace l'appel direct à l'API Google.
VITE_GEMINI_PROXY_URL=
# Chemin du modèle Gemma au format MediaPipe (.task) placé dans public/models/
VITE_GEMMA_MODEL_PATH=/models/gemma3-1b-it-int4-web.task
