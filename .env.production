# Utilisé par `npm run build` (local ET Vercel). Aucune valeur secrète ici.
# La clé est vidée pour qu'elle ne soit JAMAIS intégrée au site publié :
VITE_GEMINI_API_KEY=
# Le navigateur passe par le relais serveur api/gemini.ts :
VITE_GEMINI_PROXY_URL=/api/gemini
# URL publique du modèle Gemma (à remplacer par ton propre dépôt Hugging Face, voir docs/deploiement.md) :
VITE_GEMMA_MODEL_PATH=https://huggingface.co/gmuntu/scratch-socratique-gemma/resolve/main/gemma3-1b-it-int4-web.task
